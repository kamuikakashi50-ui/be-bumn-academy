# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=be-bumn-academy
HTTP_PORT=8000
# Direktori berkas media ruang kelas (video & e-book) yang disajikan pada
# /api/v1/media/*. Di Docker otomatis /app/media.
MEDIA_DIR=./media
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
# Timeout default untuk setiap request (context)
REQUEST_TIMEOUT=20s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Catatan: docker-compose memetakan PostgreSQL ke port host 55432 (bukan 5432)
# agar tidak bentrok dengan PostgreSQL lokal yang mungkin sudah berjalan.
# Ubah lewat POSTGRES_HOST_PORT bila perlu.
DB_HOST=localhost
DB_PORT=55432
DB_USER=bumn
DB_PASSWORD=bumn
DB_NAME=bumn_academy
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Connection pool — dinaikkan agar kuat saat tryout serentak
DB_MAX_OPEN_CONNS=60
DB_MAX_IDLE_CONNS=30
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m

# Aktifkan prepared statement GORM (lebih cepat saat trafik tinggi)
DB_PREPARE_STMT=true

# Jalankan migrasi otomatis saat server start
DB_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Redis (opsional — jika kosong, cache & rate limit memakai fallback in-memory)
# ---------------------------------------------------------------------------
# docker-compose memetakan Redis ke port host 56379 (lihat REDIS_HOST_PORT).
REDIS_ADDR=localhost:56379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_ENABLED=true
# TTL cache
CACHE_CATALOG_TTL=5m
CACHE_QUESTION_BANK_TTL=15m

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_ISSUER=be-bumn-academy
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# ---------------------------------------------------------------------------
# CORS (dipisah koma)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Rate limit (per IP / per user)
# ---------------------------------------------------------------------------
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60

# ---------------------------------------------------------------------------
# Bisnis
# ---------------------------------------------------------------------------
# Persen diskon referral
REFERRAL_DISCOUNT_PERCENT=10
# Ambang batas kelulusan simulasi (0-100)
PASSING_THRESHOLD=70
# ---------------------------------------------------------------------------
# Midtrans (pembayaran)
# ---------------------------------------------------------------------------
# Kosongkan kredensial untuk memakai simulator sandbox lokal (alur webhook tetap
# diuji, tanpa akun Midtrans). Isi dengan kunci dari MAP > Settings > Access Keys
# (mode Sandbox) untuk memakai Snap asli.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Simulator pembayaran lokal (POST /orders/{id}/sandbox/settle) yang mengirim
# notifikasi tiruan bertanda tangan ke jalur webhook. WAJIB false di produksi
# nyata; otomatis nonaktif bila MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SANDBOX_SIMULATOR=true

# Batas waktu permintaan ke API Midtrans.
MIDTRANS_TIMEOUT=20s

# Opsional: arahkan permintaan Snap/Core ke domain lain (mock server saat
# pengujian atau proxy internal). Kosong = domain resmi Midtrans.
MIDTRANS_SNAP_BASE_URL=
MIDTRANS_CORE_BASE_URL=

# Basis URL front-end untuk pengalihan Snap (finish/unfinish/error) dan tautan
# kembali ke halaman pembayaran dashboard.
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed data demo saat startup (matikan di produksi)
# ---------------------------------------------------------------------------
SEED_ON_START=true

# ---------------------------------------------------------------------------
# Mentor AI ("MinSmart") — ulasan hasil tryout
# ---------------------------------------------------------------------------
AI_ENABLED=true

# Provider: stub | ark | openai
#   stub   = mentor heuristik lokal (tanpa jaringan, selalu tersedia)
#   ark    = BytePlus Ark (endpoint kompatibel OpenAI)
#   openai = endpoint lain yang kompatibel OpenAI (OpenAI, DeepSeek, Ollama, vLLM)
AI_PROVIDER=stub

# Endpoint kompatibel OpenAI. BytePlus Ark (region ap-southeast-1):
#   https://ark.ap-southeast.bytepluses.com/api/v3
AI_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Wajib diisi bila AI_PROVIDER bukan "stub". Tanpa kunci ini, backend otomatis
# memakai mentor heuristik lokal.
AI_API_KEY=

# Id model yang sudah diaktifkan pada akun penyedia.
AI_MODEL=deepseek-v4-flash-260425

AI_TIMEOUT=45s
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1200

# Pakai mentor heuristik lokal bila provider utama gagal (kuota habis,
# model belum diaktifkan, gangguan jaringan).
AI_FALLBACK_ENABLED=true

# Kuota permintaan AI per peserta per hari (0 = tanpa batas).
AI_DAILY_QUOTA=120

# Batas konteks yang dikirim ke model.
AI_MAX_CONTEXT_QUESTIONS=40
AI_MAX_HISTORY_MESSAGES=12

# Endpoint SSE /attempts/{id}/ai/chat/stream
AI_STREAM_ENABLED=true

# Analisis hasil tryout dihitung sekali lalu dipakai ulang.
AI_ANALYSIS_CACHE_TTL=168h
